{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flss.local/schema/programme/1",
  "title": "FLSS Programme (PLAN-FLSS-006 Phase 2; CAP-60.3; A-6-12)",
  "description": "A plan a coach or a person writes for one area: targets and generators for the area's measures over a number of weeks. Importing it makes a DRAFT plan the person approves; nothing is a baseline until they do. It holds no figure of anyone's record, no entry and no name of a person. additionalProperties is false at every level.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack_id", "version", "kind", "title", "area_key", "weeks", "measures"],
  "properties": {
    "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "kind": {"const": "programme"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "author": {"type": "string", "maxLength": 80},
    "summary": {"type": "string", "maxLength": 400},
    "area_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$", "description": "the key of the area the plan is for: a shipped pack's area key, or a key the person's own area was given"},
    "weeks": {"type": "integer", "minimum": 1, "maximum": 52},
    "sessions_per_week": {"type": "number", "exclusiveMinimum": 0, "maximum": 14},
    "measures": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["key", "generator"],
        "properties": {
          "key": {"type": "string", "maxLength": 120, "description": "the measure's key in the person's record (a pack measure's key such as strength.sessions_completed)"},
          "generator": {"enum": ["cumulative_per_week", "rate_per_week", "level_linear", "maintain_band", "milestones"]},
          "per_week": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000000},
          "target": {"type": "number"},
          "centre": {"type": "number"},
          "tolerance": {"type": "number", "exclusiveMinimum": 0},
          "unit": {"enum": ["kg", "lb", "m", "km", "mi", "s_per_km", "s_per_mi"]},
          "steps": {"type": "array", "maxItems": 52, "items": {"type": "object", "additionalProperties": false, "required": ["week", "value"],
                    "properties": {"week": {"type": "integer", "minimum": 1, "maximum": 52}, "value": {"type": "number"}}}}
        }
      }
    }
  }
}
